// Init scripts

sh_binary {
	name: "init.qcom.early_boot.sh",
	src: "init.qcom.early_boot.sh",
	vendor: true,
}

sh_binary {
	name: "init.qcom.sh",
	src: "init.qcom.sh",
	vendor: true,
}

sh_binary {
	name: "init.qcom.usb.sh",
	src: "init.qcom.usb.sh",
	vendor: true,
}

// Init configuration files

prebuilt_etc {
	name: "init.qcom.rc",
	src: "init.qcom.rc",
	sub_dir: "init/hw",
	vendor: true,
}

prebuilt_etc {
	name: "init.target.rc",
	src: "init.target.rc",
	sub_dir: "init/hw",
	vendor: true,
}

prebuilt_etc {
	name: "init.qcom.usb.rc",
	src: "init.qcom.usb.rc",
	sub_dir: "init/hw",
	vendor: true,
}

prebuilt_etc {
	name: "init.recovery.qcom.rc",
	src: "init.recovery.qcom.rc",
	sub_dir: "init",
	recovery: true,
}

prebuilt_etc {
	name: "ueventd.qcom.rc",
	filename: "ueventd.rc",
	src: "ueventd.qcom.rc",
	vendor: true,
}
